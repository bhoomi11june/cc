def dfs(visited, graph, node):
    if node not in visited:
        print(node, end=" ")
        visited.add(node)
        for neighbor in graph.get(node, []):
            dfs(visited, graph, neighbor)

# --- User Input Section ---
graph = {}
n = int(input("How many edges does your graph have? "))

print("Enter each edge as 'node1 node2' (e.g., A B):")
for _ in range(n):
    u, v = input().split()
    # Add u -> v
    if u not in graph: graph[u] = []
    graph[u].append(v)
    # Add v -> u (because it's undirected)
    if v not in graph: graph[v] = []
    graph[v].append(u)

start_node = input("Enter the starting node for DFS: ")

print("\nDFS Traversal result:")
dfs(set(), graph, start_node)
